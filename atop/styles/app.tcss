/* ================================
   Main application
   ================================ */

Screen {
    background: $surface;
    color: $text;
}


/* ================================
   Header / Footer
   ================================ */

#header {
    height: 3;
    width: 100%;
}

#footer {
    height: 1;
    width: 100%;
}


/* ================================
   Widget Grid
   ================================ */

#widgets {
    width: 100%;
    height: 1fr;

    layout: grid;

    /* Six widgets per row */
    grid-size: 6 1;

    /* Space between widgets */
    grid-gutter: 1;
}


/* ================================
   Individual Widgets
   ================================ */

#cpu-widget,#memory-widget,#disk-widget,#network-widget {
    width: 1fr;
    height: 100%;

    border: solid $primary-darken-2;

    padding: 0 1;
}


/* ================================
   Widget Titles
   ================================ */

.metric-title {
    height: 1;
    width: 100%;

    text-style: bold;
}


/* ================================
   Charts
   ================================ */

.metric-chart {
    width: 100%;
    height: 1fr;
}