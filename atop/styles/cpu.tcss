#cpu-widget {
    width: 1fr;
    height: 14;
    padding: 1;
    background: #071522;
    border: round #1b3448;
}

#cpu-title {
    height: 1;
    color: #39d7ff;
    text-style: bold;
}

#cpu-usage {
    height: 1;
    color: #39d7ff;
    text-style: bold;
}

#cpu-load {
    height: 2;
    color: #b0bfce;
}

#cpu-chart {
    width: 100%;
    height: 7;
}